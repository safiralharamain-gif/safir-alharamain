; Engine configuration file.
; SAFIR Hajj & Umrah Training — Photoreal Prototype v6

config_version=5

[application]
config/name="شخصيه الحج والعمره 6"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.015,0.018,0.025,1)
boot_splash/show_image=false

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=4096
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1

[physics]
3d/default_gravity=18.0
